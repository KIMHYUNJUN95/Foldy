{
  "name": "Foldy Admin",
  "short_name": "Foldy Admin",
  "description": "Foldy operations console for office and management teams.",
  "lang": "ko",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "id": "/admin",
  "scope": "/admin",
  "start_url": "/admin",
  "display": "standalone",
  "launch_handler": { "client_mode": "navigate-existing" },
  "prefer_related_applications": false,
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
