NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support contact for blocked-account screens (suspended / disabled). The "contact admin"
# / "contact support" CTAs open a prefilled mailto: to this address. Leave empty to fall
# back to an empty recipient (the user fills it in their mail client).
NEXT_PUBLIC_SUPPORT_EMAIL=

# Local development tools only. Never set this in production or staging.
# This gates dev-only maintenance endpoints; it does not provide a test-login shortcut.
ENABLE_LOCAL_DEV_TOOLS=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BEDS24_WEBHOOK_SECRET=
BEDS24_DEFAULT_ORGANIZATION_ID=
BEDS24_API_BASE_URL=
BEDS24_API_TOKEN=
# Long-lived refresh token — used to mint access tokens when BEDS24_API_TOKEN is unset/expired.
BEDS24_API_REFRESH_TOKEN=
# Sync pause flag. Unset/empty defaults to ACTIVE. Set to one of 1/true/on/yes to pause
# webhook, reconcile, and review-sync processing.
BEDS24_SYNC_PAUSED=

# Shared authorization for CRON-secret endpoints (Beds24 reconcile/review maintenance,
# Todo reminders, and attendance reminders). Vercel Cron sends it automatically only
# for routes listed in vercel.json; GitHub Actions/manual callers must send the header.
CRON_SECRET=

# Optional on-demand external-review translation. Server-only.
DEEPL_API_KEY=
# Optional override; normally selected automatically from the DeepL key tier.
DEEPL_API_URL=

# Single-channel Incoming Webhook for Todo daily reports. Server-only; never expose this URL to the browser.
SLACK_DAILY_REPORT_WEBHOOK_URL=

# Optional operator-alert webhook. Must be a different channel from daily reports.
SLACK_OPS_ALERT_WEBHOOK_URL=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 선택. 받은 Beds24 배달을 그대로 넘길 주소(줄바꿈/쉼표로 여러 개).
# 미설정이 기본 — 전환기에만 쓴다. docs/engineering/07-environment-setup.md 참고.
BEDS24_PRICE_WEBHOOK_FORWARD_URL=

# LiveKit — self check-in staff call (server only, Foldy + apps/checkin). Production URL must be wss://
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
