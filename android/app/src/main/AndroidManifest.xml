<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 백업 끔(2026-10-09): 앱 데이터에는 WebView 로그인 쿠키가 있다. 클라우드 백업 · 기기 이전으로 다른 기기에 로그인 상태가 복원되지 않게
         allowBackup=false(Android 11 이하) + dataExtractionRules(12 이상, 클라우드 · 기기 이전 모두 제외). 새 기기에서는 다시 로그인한다. -->

    <!-- 예측 뒤로가기(2026-10-20): OS 가 뒤로 제스처의 진행을 앱에 알린다 → PredictiveBackPlugin 이 웹 스와이프 엔진으로 넘긴다.
         targetSdk 36 은 기본값이 켜짐이지만 명시해 둔다. -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 앱 전용 스킴 — Google 로그인 후 시스템 브라우저가 com.harutokyo.foldy://auth/callback 으로 앱을 연다.
                 src/lib/native-app.ts NATIVE_APP_SCHEME · iOS Info.plist · Supabase Redirect URLs 와 같아야 한다 (2026-10-06). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.harutokyo.foldy" />
            </intent-filter>

            <!-- 앱 아이콘 꾹 누르기 메뉴(2026-10-22) — res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 출퇴근 QR 스캔 · 사진 첨부(카메라), 출퇴근 인증 순간의 위치. 웹(getUserMedia · Geolocation)이 요청하면
         Capacitor 의 WebChromeClient 가 런타임 권한을 묻는다 (2026-10-06). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
